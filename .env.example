# Copy to .env and adjust.
DATABASE_URL=postgresql:///makers?host=/var/run/postgresql
CONTENT_CACHE_TTL_MS=30000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard — change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zerocall
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Optional: require x-api-key (or ?key=) on POST /api/leads.
# LEADS_API_KEY=replace-with-a-lead-intake-key
