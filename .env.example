# Copy to .env and adjust.
# Local dev (unix socket):  postgresql:///makers?host=/var/run/postgresql
# Neon / managed Postgres:  postgresql://user:pass@host/db?sslmode=verify-full
#   - runtime/app: use the PgBouncer ("-pooler") host
#   - migrations / long tasks: use DATABASE_URL_UNPOOLED
DATABASE_URL=postgresql:///makers?host=/var/run/postgresql
# DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=verify-full

# Per-instance pool size. Defaults to 1 on serverless, 5 locally.
# PG_POOL_MAX=1

CONTENT_CACHE_TTL_MS=30000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard — change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zerocall
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Optional: require x-api-key (or ?key=) on POST /api/leads.
# LEADS_API_KEY=replace-with-a-lead-intake-key

# Product analytics (PostHog). The project key is a public browser key, not a
# personal API key. Leave it empty (or unset) and the integration stays inert.
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud: https://us.i.posthog.com — EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
